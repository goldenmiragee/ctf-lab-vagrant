# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# ctf-lab-vagrant — multi-VM penetration-testing / CTF lab.
#
# All machines sit on an ISOLATED VirtualBox host-only network (192.168.56.0/24).
# The intentionally-vulnerable targets have NO NAT/bridged adapter beyond what the
# base box needs to install packages at build time — never expose them to a real network.
#
# Phasing: heavy boxes (kali, metasploitable, dc01) have `autostart: false`, so a bare
# `vagrant up` brings up only the Phase 1 targets. Bring the others up explicitly, e.g.
#   vagrant up metasploitable
#   vagrant up dc01
#
# Usage:
#   vagrant up ubuntu-server ubuntu-client dvwa juiceshop   # Phase 1
#   vagrant status
#   vagrant destroy -f <name>                               # reset one box

Vagrant.require_version ">= 2.2.0"

# --- machine definitions -------------------------------------------------------
# box       : Vagrant box image
# ip        : static host-only address
# cpus/mem  : VM resources
# script    : Linux shell provisioner (relative path) — nil for Windows
# ps        : Windows PowerShell provisioner — nil for Linux
# autostart : whether a bare `vagrant up` includes it (phasing)
# comm      : communicator ("ssh" default, "winrm" for Windows)
MACHINES = {
  "ubuntu-server" => {
    box: "bento/ubuntu-22.04", ip: "192.168.56.30", cpus: 1, mem: 1024,
    script: "provision/ubuntu-server.sh", autostart: true,
  },
  "ubuntu-client" => {
    box: "bento/ubuntu-22.04", ip: "192.168.56.31", cpus: 1, mem: 1024,
    script: "provision/ubuntu-client.sh", autostart: true,
  },
  "dvwa" => {
    box: "bento/ubuntu-22.04", ip: "192.168.56.21", cpus: 1, mem: 1024,
    script: "provision/dvwa.sh", autostart: true,
  },
  "juiceshop" => {
    box: "bento/ubuntu-22.04", ip: "192.168.56.22", cpus: 2, mem: 2048,
    script: "provision/juiceshop.sh", autostart: true,
  },

  # ---- Phase 2 (service exploitation) -- brought up on demand ----
  "metasploitable" => {
    box: "rapid7/metasploitable3-ub1404", ip: "192.168.56.20", cpus: 1, mem: 1024,
    script: nil, autostart: false,
    # this box rejects Vagrant's key insertion; use its built-in vagrant creds
    ssh_user: "vagrant", ssh_pass: "vagrant", insert_key: false,
  },

  # ---- Phase 3 (Active Directory) -- heavy, brought up on demand ----
  "dc01" => {
    box: "StefanScherer/windows_2019", ip: "192.168.56.40", cpus: 2, mem: 4096,
    ps: "provision/dc01.ps1", autostart: false, comm: "winrm",
  },

  # ---- attacker box (optional, large download) -- brought up on demand ----
  "kali" => {
    box: "kalilinux/rolling", ip: "192.168.56.10", cpus: 2, mem: 2048,
    script: nil, autostart: false,
  },
}

Vagrant.configure("2") do |config|
  config.vm.boot_timeout = 600

  MACHINES.each do |name, m|
    config.vm.define name, autostart: m[:autostart] do |node|
      node.vm.box = m[:box]
      node.vm.hostname = name
      node.vm.communicator = m[:comm] if m[:comm]

      # some prebuilt boxes reject key insertion; fall back to their built-in creds
      node.ssh.insert_key = false if m[:insert_key] == false
      node.ssh.username = m[:ssh_user] if m[:ssh_user]
      node.ssh.password = m[:ssh_pass] if m[:ssh_pass]

      # isolated host-only network with a fixed address
      node.vm.network "private_network", ip: m[:ip]

      node.vm.provider "virtualbox" do |vb|
        vb.name   = "ctf-#{name}"
        vb.cpus   = m[:cpus]
        vb.memory = m[:mem]
        vb.gui    = false
        # keep the vulnerable guests quiet on the host
        vb.customize ["modifyvm", :id, "--audio-driver", "none"]
      end

      # provisioning
      if m[:script]
        # Linux: run the machine script. It sources /vagrant/provision/flags.env
        # (synced folder) to plant flag values generated by generate.py.
        node.vm.provision "shell", path: m[:script]
      elsif m[:ps]
        # Windows: PowerShell provisioner (Phase 3).
        node.vm.provision "shell", path: m[:ps]
      end
    end
  end
end
